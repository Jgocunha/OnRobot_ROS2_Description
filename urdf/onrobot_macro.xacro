<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

    <!-- Include the macro file for the specific OnRobot model -->
    <xacro:macro name="onrobot"
        params="
        onrobot_type
        prefix:=''
        sim_gazebo:=false
        emit_gz_plugin:=true
        use_fake_hardware:=false
        connection_type:=serial
        device:=/tmp/ttyUR
        ip_address:=192.168.1.1
        port:=502
        ">

        <!-- In Gazebo the knuckle (finger_joint, [rad]) is actuated instead of the massless
             finger_width slider ([m]); see onrobot_rgX in rgX_macro.xacro. -->
        <xacro:property name="actuated_joint" value="${'finger_joint' if sim_gazebo else 'finger_width'}"/>

        <xacro:if value="${onrobot_type == 'rg2'}">
            <xacro:include filename="$(find onrobot_description)/urdf/rg2_macro.xacro"/>
            <xacro:onrobot_rg2 prefix="${prefix}" actuated_joint="${actuated_joint}"/>
        </xacro:if>
        <xacro:if value="${onrobot_type == 'rg6'}">
            <xacro:include filename="$(find onrobot_description)/urdf/rg6_macro.xacro"/>
            <xacro:onrobot_rg6 prefix="${prefix}" actuated_joint="${actuated_joint}"/>
        </xacro:if>

        <!-- Enable the Gazebo Sim (Fortress) ros2_control plugin for simulation.
             Set emit_gz_plugin:=false when a parent URDF provides the single plugin
             block (e.g. several grippers/arms sharing one controller_manager). -->
        <xacro:if value="${sim_gazebo and emit_gz_plugin}">
            <gazebo>
                <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin"/>
            </gazebo>
        </xacro:if>

        <!-- Define the OnRobot gripper hardware interface for ROS 2 control.
             Name is prefixed so several grippers can coexist in one resource manager. -->
        <ros2_control name="${prefix}OnRobotGripper" type="${'system' if sim_gazebo else 'actuator'}">
            <hardware>
                <xacro:if value="${sim_gazebo}">
                    <plugin>gz_ros2_control/GazeboSimSystem</plugin>
                </xacro:if>
                <xacro:if value="${use_fake_hardware}">
                    <plugin>test_hardware_components/TestSingleJointActuator</plugin>
                </xacro:if>
                <xacro:unless value="${sim_gazebo or use_fake_hardware}">
                    <plugin>onrobot_driver/RGHardwareInterface</plugin>
                    <param name="onrobot_type">${onrobot_type}</param>
                    <param name="prefix">${prefix}</param>
                    <param name="connection_type">${connection_type}</param>
                    <param name="device">${device}</param>
                    <param name="ip_address">${ip_address}</param>
                    <param name="port">${port}</param>
                </xacro:unless>
            </hardware>
            <joint name="${prefix}${actuated_joint}">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <xacro:if value="${sim_gazebo}">
                    <!-- GripperActionController claims position + velocity state -->
                    <state_interface name="velocity"/>
                </xacro:if>
            </joint>

            <!-- gz_ros2_control drives mimic joints itself: each must be listed in the same
                 ros2_control block with the mimicked joint and a multiplier (no offset support).
                 finger_width is left out on purpose: it has no mass or collision, so nothing
                 physical depends on it, and robot_state_publisher derives it from the URDF. -->
            <xacro:if value="${sim_gazebo}">
                <xacro:macro name="gz_mimic_joint" params="name k">
                    <joint name="${prefix}${name}">
                        <param name="mimic">${prefix}finger_joint</param>
                        <param name="multiplier">${k}</param>
                        <state_interface name="position"/>
                    </joint>
                </xacro:macro>
                <xacro:gz_mimic_joint name="left_inner_knuckle_joint" k="-1"/>
                <xacro:gz_mimic_joint name="left_inner_finger_joint" k="1"/>
                <xacro:gz_mimic_joint name="right_outer_knuckle_joint" k="-1"/>
                <xacro:gz_mimic_joint name="right_inner_knuckle_joint" k="-1"/>
                <xacro:gz_mimic_joint name="right_inner_finger_joint" k="1"/>
            </xacro:if>
        </ros2_control>

    </xacro:macro>
</robot>